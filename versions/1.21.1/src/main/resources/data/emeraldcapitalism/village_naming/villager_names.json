        "D9",
        "D10"
      ]
    ],
    "rule_order": "ascending_rule_index",
    "shared_across_biomes": true
  },
  "drift_rules": [
    {
      "id": "D1",
      "name": "Final nasal drops",
      "description": "Word-final m or n deletes. Kirnim > Kirni",
      "operation": "drop_final_nasal"
    },
    {
      "id": "D2",
      "name": "s lenites to h",
      "description": "Single medial s only. A geminate blocks it. Gistul > Gihtul",
      "operation": "lenite_medial_s_to_h"
    },
    {
      "id": "D3",
      "name": "i lowers to e",
      "description": "Every i. Kirnim > Kernem",
      "operation": "lower_i_to_e"
    },
    {
      "id": "D4",
      "name": "u lowers to o",
      "description": "Every u. Muknek > Moknek",
      "operation": "lower_u_to_o"
    },
    {
      "id": "D5",
      "name": "Geminates simplify",
      "description": "Any doubled consonant. Lommun > Lomun",
      "operation": "simplify_geminates"
    },
    {
      "id": "D6",
      "name": "Final liquid drops",
      "description": "Word-final l or r deletes. Gistul > Gistu",
      "operation": "drop_final_liquid"
    },
    {
      "id": "D7",
      "name": "Final stop to nasal",
      "description": "k and g to ng, t and d to n, p and b to m. Muknek > Mukneng",
      "operation": "change_final_stop_to_nasal"
    },
    {
      "id": "D8",
      "name": "k lenites to h",
      "description": "Single medial k only. Muknek > Muhnek",
      "operation": "lenite_medial_k_to_h"
    },
    {
      "id": "D9",
      "name": "Initial stop voices",
      "description": "p to b, t to d, k to g. Penkem > Benkem",
      "operation": "voice_initial_stop"
    },
    {
      "id": "D10",
      "name": "Initial stop devoices",
      "description": "b to p, d to t, g to k. Gistul > Kistul",
      "operation": "devoice_initial_stop"
    },
    {
      "id": "D11",
      "name": "t lenites to s",
      "description": "Single medial t only. Widtor > Widsor",
      "operation": "lenite_medial_t_to_s"
    },
    {
      "id": "D12",
      "name": "m lenites to w",
      "description": "Single medial m only. Tempum > Tewpum",
      "operation": "lenite_medial_m_to_w"
    }
  ],
