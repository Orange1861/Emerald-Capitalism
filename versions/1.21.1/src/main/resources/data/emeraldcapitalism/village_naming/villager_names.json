  "junction": {
    "stop_segments": "bdgkpt",
    "vowels": "aeiou",
    "stop_deletes_before_consonant": true,
    "identical_consonants_geminate": true,
    "gemination_wins_over_stop_deletion": true
  },
  "biome_rules": {
    "plains": {
      "operation": "none"
    },
    "savanna": {
      "operation": "simplify_geminates"
    },
    "desert": {
      "operation": "replace",
      "from": "e",
      "to": "i"
    },
    "taiga": {
      "operation": "replace",
      "from": "o",
      "to": "u"
    },
    "snowy": {
      "operation": "delete_final_stops",
      "segments": "bdgkpt"
    }
  },
  "drift_assignment": {
    "model": "independent_low_frequency_value_noise",
    "threshold": 0.78,
    "feature_sizes": [
      4096,
      5120,
      3072,
      6144,
      2048,
