# Disable autocrlf on generated files, they always generate with LF
# Add any extra files or paths here to make git stop saying they
# are changed when only line endings change.
src/generated/**/.cache/cache text eol=lf
src/generated/**/*.json text eol=lf

# Normalize all source and common text files to LF
*.java text eol=lf
*.json text eol=lf
*.gradle text eol=lf
*.groovy text eol=lf
*.gradle.kts text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.html text eol=lf
*.lang text eol=lf
*.snbt text eol=lf
*.mcmeta text eol=lf
*.gitignore text eol=lf
*.gitkeep text eol=lf
*.log text eol=lf
*.bak text eol=lf
*.mixins.json text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Leave binaries alone - do not let git touch these at all
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.class binary
*.zip binary
*.dat binary
*.nbt binary
*.ogg binary
